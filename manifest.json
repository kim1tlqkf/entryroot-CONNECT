{
  "manifest_version": 3,
  "name": "엔트리 실시간 합작",
  "version": "0.2.1",
  "description": "엔트리 작품 만들기 화면에서 친구와 같은 작품을 실시간으로 함께 고칩니다(브라우저끼리 직접 연결).",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://playentry.org/ws/*"],
      "run_at": "document_idle",
      "world": "MAIN",
      "js": [
        "vendor/peerjs.min.js",
        "src/merge.js",
        "src/sync.js",
        "src/entry-adapter.js",
        "src/net.js",
        "src/ui.js",
        "src/main.js"
      ]
    }
  ]
}
